<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".registration.ui.signup.DisplayQeponIdFragment">

<View
    android:id="@+id/set_up_qepon"
    android:layout_width="match_parent"
    android:layout_height="293dp"
    android:background="@drawable/qepon_gradient_bg_alt"
    android:orientation="vertical"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent"/>

<TextView
    android:id="@+id/welcome"
    style="@style/Signal.Text.Headline.Registration"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="center_horizontal"
    android:layout_marginTop="50dp"
    android:lineSpacingExtra="2sp"
    android:text="@string/welcome_title"
    android:textColor="@color/white"
    android:textSize="24sp"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent" />

<TextView
    android:id="@+id/has_generate"
    style="@style/Signal.Text.Headline"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="center_horizontal"
    android:layout_marginTop="16dp"
    android:text="@string/display_qeponid_subtitle"
    android:textColor="@color/white"
    android:textSize="18sp"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toBottomOf="@+id/welcome" />

<LinearLayout
    android:id="@+id/overlay"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:layout_marginStart="32dp"
    android:layout_marginEnd="24dp"
    android:background="@drawable/rounded_rectangle_white_shadow"
    android:orientation="vertical"
    app:layout_constraintBottom_toBottomOf="@+id/set_up_qepon"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toBottomOf="@+id/set_up_qepon"
    android:paddingBottom="16dp"
    android:paddingTop="16dp">

    <TextView
        android:id="@+id/congratulate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:lineSpacingExtra="6sp"
        android:text="@string/display_qeponid_your_id"
        android:textColor="#2f7294"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/your_qepon_id"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_horizontal"
        android:letterSpacing="0.07"
        android:lineSpacingExtra="-7sp"
        android:textColor="#32920a"
        android:textSize="30sp"
        tools:text="2FDRDFZM" />

    <TextView
        android:id="@+id/like_phone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="12dp"
        android:gravity="center_horizontal"
        android:lineSpacingExtra="3sp"
        android:text="@string/display_qeponid_desc"
        android:textColor="#2f7294"
        android:layout_marginLeft="45dp"
        android:layout_marginRight="45dp"
        android:textSize="12sp" />
</LinearLayout>


    <Button
        android:id="@+id/next_button"
        android:layout_width="258dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:background="@drawable/qepon_button_primary"
        android:text="@string/next"
        android:textColor="#ffffff"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/overlay" />

</androidx.constraintlayout.widget.ConstraintLayout>