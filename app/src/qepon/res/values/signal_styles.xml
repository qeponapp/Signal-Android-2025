<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Boleh biarkan overlay seperti semula; fokus di style tombol -->
    <style name="ThemeOverlay.Signal.CircularProgressIndicator.Tonal" parent="ThemeOverlay.Material3">
        <item name="circularProgressMaterialButtonStyle">@style/Signal.Widget.Button.Large.Tonal.Qepon</item>
        <item name="circularProgressIndicatorStyle">@style/Widget.Signal.CircularProgressIndicator.Medium.Indeterminate</item>
    </style>

    <!-- OVERRIDE tombol -->
    <style name="Signal.Widget.Button.Large.Tonal.Qepon" parent="Signal.Widget.Button.Large.Tonal">
        <!-- background & label -->
        <item name="backgroundTint">@color/qepon_button_bg</item>
        <item name="android:textColor">@color/qepon_button_text</item>
        <item name="iconTint">@color/qepon_button_text</item>

        <!-- opsi estetika -->
        <item name="rippleColor">@color/qepon_button_ripple</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textStyle">bold</item>
        <!-- kalau mau radius lebih rounded -->
        <!-- <item name="cornerRadius">20dp</item> -->
    </style>

    <!-- Primary brand button: filled, rounded, with white label and 1dp white stroke -->
    <style name="Qepon.Widget.Button.Primary" parent="Widget.Material3.Button">

        <!-- fill & text -->
        <item name="backgroundTint">@color/qepon_button_bg_alt</item>
        <item name="android:textColor">@color/white</item>

        <!-- stroke -->
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/white</item>

        <item name="android:textAllCaps">true</item>
        <item name="android:textStyle">bold</item>


    </style>




</resources>